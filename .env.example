# Ollama
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODEL=ministral-3:3b
OLLAMA_TEMPERATURE=0.0
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT=300
PROMPT_PATH=src/ollama_runner/prompts/homeassist.md

# Postgres cache
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=ollama
POSTGRES_PASSWORD=ollama
POSTGRES_DB=ollama_runner

# Whisper ASR server (OpenAI-compatible)
WHISPER_HOST=127.0.0.1
WHISPER_PORT=9000
WHISPER_PATH=/v1/audio/transcriptions
WHISPER_TIMEOUT=120

# FastText vectors
FASTTEXT_MODEL_PATH=cc.ru.300.bin

# Home Assistant (stub sink for now)
HA_HOST=127.0.0.1
HA_PORT=8123
HA_TOKEN=

# Assist HTTP API (for Home Assistant custom ConversationEntity)
ASSIST_API_HOST=127.0.0.1
ASSIST_API_PORT=8765
ASSIST_API_TOKEN=
ASSIST_API_TIMEOUT=20
